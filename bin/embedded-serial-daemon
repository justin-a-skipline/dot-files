#!/usr/bin/env python3
"""
Serial terminal daemon for embedded device
- Owns /dev/ttyUSB0 directly
- Creates PTY for minicom
- Listens on named pipe for automated commands
- Logs everything
- Runs in background
"""

import os
import sys
import pty
import select
import signal
import fcntl
from pathlib import Path

try:
    import serial
except ImportError:
    print("Error: pyserial not installed. Install with: sudo apt install python3-serial")
    sys.exit(1)

SERIAL_PORT = '/dev/ttyUSB0'
BAUD_RATE = 115200
VIRTUAL_PORT = '/tmp/embedded-virtual'
CMD_FIFO = '/tmp/embedded-cmd-fifo'
LOG_FILE = '/tmp/embedded-serial.log'
PID_FILE = '/tmp/embedded-serial.pid'

# Global flag for cleanup
running = True

def cleanup(signum=None, frame=None):
    """Clean up resources on exit"""
    global running
    # Determine if this is a shutdown (called by signal) or initial cleanup
    is_shutdown = signum is not None

    if is_shutdown:
        running = False

    # Remove FIFO
    try:
        if os.path.exists(CMD_FIFO):
            os.unlink(CMD_FIFO)
    except:
        pass

    # Remove PID file only on shutdown, not initial cleanup
    if is_shutdown:
        try:
            if os.path.exists(PID_FILE):
                os.unlink(PID_FILE)
        except:
            pass

    # Remove virtual port symlink
    try:
        if os.path.islink(VIRTUAL_PORT):
            os.unlink(VIRTUAL_PORT)
    except:
        pass

    if signum is not None:
        sys.exit(0)

def signal_handler(signum, frame):
    """Handle signals"""
    cleanup(signum, frame)

def setup_signals():
    """Set up signal handlers"""
    signal.signal(signal.SIGINT, signal_handler)
    signal.signal(signal.SIGTERM, signal_handler)
    signal.signal(signal.SIGPIPE, signal.SIG_IGN)
    signal.signal(signal.SIGTTIN, signal.SIG_IGN)  # Ignore when backgrounded
    signal.signal(signal.SIGTTOU, signal.SIG_IGN)  # Ignore when backgrounded

def main():
    global running

    setup_signals()

    # Write PID file
    with open(PID_FILE, 'w') as f:
        f.write(str(os.getpid()))

    # Clean up any existing FIFO/virtual port
    cleanup()

    # Create command FIFO
    try:
        os.mkfifo(CMD_FIFO)
    except FileExistsError:
        os.unlink(CMD_FIFO)
        os.mkfifo(CMD_FIFO)

    # Open serial port
    try:
        ser = serial.Serial(SERIAL_PORT, BAUD_RATE, timeout=0)
        print(f"Opened {SERIAL_PORT} at {BAUD_RATE} baud")
    except serial.SerialException as e:
        print(f"Error opening serial port: {e}")
        print(f"Is {SERIAL_PORT} connected?")
        cleanup()
        sys.exit(1)

    # Create PTY pair
    master_fd, slave_fd = pty.openpty()
    slave_name = os.ttyname(slave_fd)
    print(f"Created PTY: {slave_name}")

    # Create symlink to virtual port name
    try:
        os.symlink(slave_name, VIRTUAL_PORT)
        print(f"Created symlink: {VIRTUAL_PORT} -> {slave_name}")
    except FileExistsError:
        os.unlink(VIRTUAL_PORT)
        os.symlink(slave_name, VIRTUAL_PORT)
        print(f"Replaced symlink: {VIRTUAL_PORT} -> {slave_name}")

    # Close slave PTY fd - minicom will open it
    os.close(slave_fd)

    # Open log file
    try:
        log_file = open(LOG_FILE, 'a')
        print(f"Logging to: {LOG_FILE}")
    except IOError as e:
        print(f"Error opening log file: {e}")
        cleanup()
        sys.exit(1)

    # Open FIFO for reading (non-blocking)
    try:
        fifo_fd = os.open(CMD_FIFO, os.O_RDONLY | os.O_NONBLOCK)
        print(f"Command FIFO ready: {CMD_FIFO}")
    except OSError as e:
        print(f"Error creating FIFO: {e}")
        cleanup()
        sys.exit(1)

    # Set master_fd to non-blocking
    flags = fcntl.fcntl(master_fd, fcntl.F_GETFL)
    fcntl.fcntl(master_fd, fcntl.F_SETFL, flags | os.O_NONBLOCK)

    print("\n" + "="*60)
    print("Serial daemon is running")
    print("="*60)
    print(f"Virtual port: {VIRTUAL_PORT}")
    print(f"Command FIFO: {CMD_FIFO}")
    print(f"PID file: {PID_FILE}")
    print("="*60 + "\n")

    # Main event loop
    while running:
        # Use select to wait for data
        try:
            readable, _, _ = select.select([master_fd, ser.fileno(), fifo_fd], [], [], 0.1)
        except ValueError:
            # One of the fds was closed (likely FIFO)
            readable = []
        except Exception as e:
            print(f"Select error: {e}")
            break

        for source in readable:
            try:
                if source == master_fd:
                    # Data from minicom (user input) -> send to serial
                    data = os.read(master_fd, 1024)
                    if data:
                        ser.write(data)

                elif source == ser.fileno():
                    # Data from serial (device output) -> send to minicom PTY
                    data = ser.read(1024)
                    if data:
                        os.write(master_fd, data)

                elif source == fifo_fd:
                    # Command from FIFO -> send to serial
                    data = os.read(fifo_fd, 1024)
                    if data:
                        # Add newline if not present
                        if not data.endswith(b'\n') and not data.endswith(b'\r'):
                            data = data + b'\n'
                        ser.write(data)
                        log_file.write(f"CMD: {data.decode('utf-8', errors='ignore').strip()}\n")
                        log_file.flush()

            except OSError as e:
                if e.errno in [11, 5]:  # EAGAIN or EIO - ignore and continue
                    continue
                else:
                    print(f"Error: {e}")
                    break
            except Exception as e:
                print(f"Unexpected error: {e}")
                break

    # Cleanup
    print("\nShutting down...")
    try:
        ser.close()
    except:
        pass
    try:
        os.close(master_fd)
    except:
        pass
    try:
        os.close(fifo_fd)
    except:
        pass
    try:
        log_file.close()
    except:
        pass

    cleanup()
    print("Done.")

if __name__ == '__main__':
    main()
