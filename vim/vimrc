"""""""""""""""""""""""""""""""""""""""""""""""""""""
function! s:SimpleTerminalToggle(win_var, buf_var, scope, term_name, split_cmd, size)
  " The window variable is always tab-local -- each tab needs its own window onto
  " the terminal. It is the buffer variable going global that makes a global
  " terminal the same terminal in every tab.
  let l:win_var_name = 't:'.a:win_var
  let l:buf_var_name = a:scope == 'global' ? 'g:'.a:buf_var : 't:'.a:buf_var

  if exists(l:win_var_name)
    let l:win_id = {l:win_var_name}
    if win_id2win(l:win_id)
      execute win_id2win(l:win_id)."wincmd w"
      hide
    endif
    unlet {l:win_var_name}
  else
    execute a:split_cmd
    if a:size > 0
      if a:split_cmd =~# 'vnew'
        execute 'vertical resize '.a:size
      else
        execute 'resize '.a:size
      endif
    endif
    let {l:win_var_name} = win_getid(winnr())
    if exists(l:buf_var_name) && bufexists({l:buf_var_name})
      execute "buf ".{l:buf_var_name}
    else
      call TermStart(a:term_name)
      let {l:buf_var_name} = bufnr("%")
    endif
  endif
endfunction
