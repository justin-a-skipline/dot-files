" mate-terminal's Tango palette, so a :terminal buffer looks like the real terminal.
" Vim reads g:terminal_ansi_colors and neovim reads g:terminal_color_0..15; onedark
" only ever sets the neovim names, so without this vim falls back to its own
" fluorescent defaults (#E0E000 for yellow).
let s:tango_normal = ['#2E3436', '#CC0000', '#4E9A06', '#C4A000', '#3465A4', '#75507B', '#06989A', '#D3D7CF']
let s:tango_bright = ['#555753', '#EF2929', '#8AE234', '#FCE94F', '#729FCF', '#AD7FA8', '#34E2E2', '#EEEEEC']
if has('nvim')
  function! s:ApplyTerminalColors()
    let l:palette = s:tango_normal + s:tango_bright
    for i in range(16)
      let g:terminal_color_{i} = l:palette[i]
    endfor
  endfunction
else
  " Vim brightens bold ANSI colors where mate-terminal does not, so the bright half
  " repeats the normal half. Otherwise every \e[1;3Xm came out glowing.
  function! s:ApplyTerminalColors()
    let g:terminal_ansi_colors = s:tango_normal + s:tango_normal
  endfunction
endif

