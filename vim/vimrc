function! s:LowerFirst(text)
  return tolower(a:text[0]) . a:text[1:]
endfunction
function! s:UpperFirst(text)
  return toupper(a:text[0]) . a:text[1:]
endfunction
" -range=% because a bare :S used to change only the current line, which looks
" exactly like the command not working.
command! -range=% -complete=tag -nargs=+ S call s:SearchAndReplaceKeepCase(<line1>, <line2>, <f-args>)
function! s:SearchAndReplaceKeepCase(first, last, word, replacement, ...)
  " This function takes camelCase or PascalCase search and replace string and also does replace on
  " camelCase version, PascalCase version, all lowercase version, and UPPERCASE version
  " Optionally you can pass in modifiers to the standard substitution command like c for confirm

  " Example: S aThing anotherThing
  " aThing    anotherThing
  " AThing    AnotherThing
  " athing    anotherthing
  " ATHING    ANOTHERTHING
  "
  " qaThing   qaThing
  " qAThing   qAThing
  " qathing   qathing
  " qATHING   qATHING
  "
  " aThingq   aThingq
  " AThingq   AThingq
  " athingq   athingq
  " ATHINGq   ATHINGq
  "
  " qaThingq  qaThingq
  " qAThingq  qAThingq
  " qathingq  qathingq
  " qATHINGq  qATHINGq

  " camelCase first: for a single-word argument its pattern is identical to the
  " all-lowercase one, and camelCase is the more useful of the two results.
  let l:variants = [
        \ [s:LowerFirst(a:word), s:LowerFirst(a:replacement)],
        \ [s:UpperFirst(a:word), s:UpperFirst(a:replacement)],
        \ [tolower(a:word),      tolower(a:replacement)],
        \ [toupper(a:word),      toupper(a:replacement)],
        \ ]

  " Changing only capitalisation makes every variant an identity substitution, so
  " say so rather than reporting nothing at all.
  if empty(filter(copy(l:variants), 'v:val[0] !=# v:val[1]'))
    echohl WarningMsg
    echomsg 'S: no variant of ' . a:word . ' differs from ' . a:replacement . ', nothing to do'
    echohl None
    return
  endif

  " e so a variant that does not occur is not an error. No silent!, because that
  " hid genuine failures too.
  let l:flags = 'ge' . get(a:, 1, '')
  for [l:from, l:to] in l:variants
    execute printf('%d,%ds;\C\<%s\>;%s;%s', a:first, a:last,
          \ escape(l:from, '\;.*$^~[]'), escape(l:to, '\;&~'), l:flags)
  endfor
endfunction
