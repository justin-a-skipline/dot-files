"""""""""""""""""""""""""""""""""""""""""""""""""""""
"Functions
"""""""""""""""""""""""""""""""""""""""""""""""""""""
function MyTabLine()
  let s = ''
  for i in range(tabpagenr('$'))
    " select the highlighting
    if i + 1 == tabpagenr()
      let s .= '%#TabLineSel#'
    else
      let s .= '%#TabLine#'
    endif

    " set the tab page number (for mouse clicks)
    let s .= '%' . (i + 1) . 'T'

    " the label is made by MyTabLabel()
    let s .= '   %{MyTabLabel(' . (i + 1) . ')}   '
  endfor

  " after the last tab fill with TabLineFill and reset tab page nr
  let s .= '%#TabLineFill#%T'

  " right-align the label to close the current tab page
  if tabpagenr('$') > 1
    let s .= '%=%#TabLine#%999Xclose'
  endif

  return s
endfunction

function! MyTabLabel(n)
  return getcwd(tabpagewinnr(a:n), a:n)
endfunction

set tabline=%!MyTabLine()
"""""""""""""""""""""""""""""""""""""""""""""""""""""
if !exists('s:terminal_counter')
  let s:terminal_counter = 0
endif
function! TermStart(term_name)
  let l:cmd = has('win32') ? s:windows_default_term : s:linux_default_term
  let l:name = a:term_name . s:terminal_counter
  if has('nvim')
    " termopen() takes over the current buffer the way term_start()'s curwin did.
    " There is no term_name equivalent, so the buffer gets renamed afterwards.
    if has('nvim-0.11')
      call jobstart(l:cmd, {'term': v:true})
    else
      call termopen(l:cmd)
    endif
    setlocal scrollback=100000
    execute 'keepalt file' fnameescape(l:name)
  else
    call term_start(l:cmd, {'curwin': 1, 'term_name': l:name, 'norestore': 1})
    setlocal termwinscroll=100000
  endif
  let s:terminal_counter += 1
  setlocal nonumber
endfunction

" Vim addresses a running terminal by buffer number, neovim by the job id it
" stores on that buffer.
function! s:TermSendKeys(bufnr, keys)
  if !has('nvim')
    call term_sendkeys(a:bufnr, a:keys)
    return
  endif
  let l:job = getbufvar(a:bufnr, 'terminal_job_id', 0)
  if l:job == 0
    echoerr 'buffer ' . a:bufnr . ' is not a terminal'
    return
  endif
  call chansend(l:job, a:keys)
endfunction
